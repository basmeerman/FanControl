# FanControl secrets template.
# Copy to secrets.yaml (gitignored) and fill in. Never commit real secrets.
#
#   cp secrets.yaml.example secrets.yaml
#   # edit secrets.yaml with real values, then:
#   esphome run fancontrol.yaml

# WiFi credentials
wifi_ssid: "YourWiFiNetwork"
wifi_password: "YourWiFiPassword"

# ESPHome native API encryption key (must be 32 bytes base64-encoded).
# Generate one with: esphome wizard (pick "encryption key") or
#   openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# Password that ESPHome requires for OTA uploads. Change from the placeholder.
ota_password: "REPLACE_ME_WITH_A_STRONG_PASSWORD"

# Optional MQTT settings — uncomment the mqtt: block in fancontrol.yaml to use.
# mqtt_host: "192.168.1.10"
# mqtt_user: "homeassistant"
# mqtt_password: "..."
